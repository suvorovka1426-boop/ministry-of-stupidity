{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{assets/**,test_*.py,README.md,render.yaml,supabase.sql,payments_supabase.sql}",
      "maxDuration": 30
    }
  }
}
